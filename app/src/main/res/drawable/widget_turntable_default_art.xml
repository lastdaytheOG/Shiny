<?xml version="1.0" encoding="utf-8"?>
<!-- Default circular art for turntable widget preview -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Circular gradient background -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#283A4D"
                android:centerColor="#405571"
                android:endColor="#6B8099"
                android:type="linear" />
        </shape>
    </item>
    <!-- Dark disc behind the artwork, so its anti-aliased edge never fringes -->
    <item
        android:width="140dp"
        android:height="140dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#000000" />
        </shape>
    </item>
    <!-- Centered app artwork -->
    <item
        android:width="140dp"
        android:height="140dp"
        android:drawable="@drawable/shiny_artwork_round"
        android:gravity="center" />
</layer-list>
