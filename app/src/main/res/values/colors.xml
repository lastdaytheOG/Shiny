<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="ic_launcher_static_background">#000000</color>

    <!--
      The colour the window and the splash are painted with before Compose draws.
      Chosen to match what ShinyTheme resolves `colorScheme.surface` to, so the
      hand-over from splash to content does not cross a colour boundary. This is the
      Material 3 baseline light surface; API 31+ overrides it with the live dynamic
      neutral in values-v31, which is what the theme actually uses there.
    -->
    <color name="shiny_launch_background">#FEF7FF</color>

    <!--
      The system splash, in every theme: the pale sky at the top of the launch artwork
      (splash_artwork.jpg), so the splash blends into the artwork as one screen.
    -->
    <color name="shiny_splash_background">#F8F6FC</color>
    <color name="legacy_icon_background">#000000</color>
    
    <!-- Widget colors for light mode -->
    <color name="widget_text_primary">#1C1B1F</color>
    <color name="widget_text_secondary">#49454F</color>
</resources>
